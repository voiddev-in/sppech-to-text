# ==============================================================================
# Whisper Speech-to-Text API Server Configuration
# ==============================================================================

# Comma-separated list of valid Bearer API keys for authentication.
# Used by Creds -> Agentic AI -> Speech to Text in api2.
WHISPER_API_KEYS=sk-whisper-local-key,sk-whisper-test-key

# Models to expose and preload into memory at startup (comma-separated).
# Example: tiny,base,small,medium,large-v3
WHISPER_MODELS=tiny,base

# Default model mapped when client requests the alias "whisper-1".
WHISPER_DEFAULT_MODEL=tiny

# Execution device: "cpu" or "cuda"
WHISPER_DEVICE=cpu

# Compute precision: "int8" for CPU, "float16" for CUDA, or "default"
WHISPER_COMPUTE_TYPE=int8

# Maximum concurrent inference tasks running simultaneously
WHISPER_MAX_CONCURRENCY=2

# Maximum queued requests waiting for an inference worker before returning 503
WHISPER_MAX_QUEUE=4

# Maximum audio upload size in megabytes (returns 413 if exceeded)
WHISPER_MAX_UPLOAD_MB=25

# Optional maximum audio duration in seconds (0 or unset for unlimited)
WHISPER_MAX_AUDIO_SEC=600

# Beam size for decoding (e.g., 5 for quality, 1 for greedy/fastest)
WHISPER_BEAM_SIZE=5

# Voice Activity Detection (VAD) filter (true/false) to suppress silence hallucinations
WHISPER_VAD=true

# Directory where Whisper model weights are stored / cached
WHISPER_MODELS_DIR=./models

# Server port to listen on
PORT=8000
